if ! command -v bun >/dev/null 2>&1; then
  for bun_bin in "${BUN_INSTALL:-$HOME/.bun}/bin" /opt/homebrew/bin /usr/local/bin; do
    if [ -x "$bun_bin/bun" ]; then
      export PATH="$bun_bin:$PATH"
      break
    fi
  done
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "Bun was not found. Install Bun or add its bin directory to PATH in ~/.config/husky/init.sh." >&2
  exit 127
fi

bun scripts/check-staged.ts
