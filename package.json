{
  "name": "life-questions",
  "version": "0.1.0",
  "private": true,
  "description": "שאלות מהחיים - אפליקציה לתוכן תורני עם סיפורים, שאלות ותשובות",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "torah",
    "jewish",
    "education",
    "hebrew",
    "stories",
    "questions"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test --preload ./tests/unit/setup.ts ./tests/unit ./components/providers/app-data-hydrator.test.tsx",
    "test:ui": "TEST_UI=1 playwright test --ui",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "test:release": "bun scripts/test-release.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check": "bun run lint && bun run typecheck && bun run check:docs && bun run test:unit",
    "audit:security": "bun audit --audit-level=high",
    "prepare": "bun scripts/install-hooks.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.4.4",
    "next-auth": "4.24.15",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.72.1",
    "tailwind-merge": "^3.5.0",
    "zod": "4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "husky": "9.1.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.12"
}
