{
  "description": "One advisory lint check per changed code state; no automatic continuation.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/codex-stop.ts\"",
            "timeout": 30,
            "statusMessage": "Checking changed code"
          }
        ]
      }
    ]
  }
}
